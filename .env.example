# Copy this file to .env and enter your rotated Quran Foundation credentials.
# Never commit .env or place the client secret in frontend code.
QF_CLIENT_ID=replace_with_your_client_id
QF_CLIENT_SECRET=replace_with_your_rotated_client_secret

# New Developer Console projects usually begin in prelive.
# Only switch to production after your production credentials and permissions are approved.
QF_ENV=prelive

# Quran Foundation translation resource ID. Verify the chosen resource in your console/API.
QF_TRANSLATION_ID=131

# Change to true only after Search API permission has been approved for this environment.
QF_SEARCH_ENABLED=false

# OAuth callback must exactly match the URL registered in the Quran Foundation Developer Console.
# For the local dual-server development setup below, the API server is on 8787 and Vite is on 5173.
QF_REDIRECT_URI=http://localhost:8787/api/auth/callback
QF_APP_URL=http://localhost:5173

# Request only scopes that have been approved for this app/environment.
# Add `bookmark collection note goal reading_session streak activity_day preference tag app_state`
# as needed for approved User APIs, and `post` if QuranReflect posting is approved.
QF_OAUTH_SCOPES=openid offline_access user

# Optional override if the Analytics API endpoint is customised for your environment.
# QF_ANALYTICS_EVENTS_URL=https://apis-prelive.quran.foundation/analytics/api/v1/events

PORT=8787
